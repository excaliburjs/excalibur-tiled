{
   "compilerOptions": {
      "outDir": "build/esm",
      "types": [
        "@vitest/browser-playwright",
        "vitest/globals"
      ],
      "moduleResolution": "bundler",
      "module": "esnext",
      "target": "es2018",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "strict": true,
      "lib": [
        "DOM",
        "DOM.Iterable", 
        "ES2019.Array",
        "es2015.promise",
        "es2015.proxy",
        "es2018.promise",
        "es2015.collection",
        "es2015.iterable",
        "dom",
        "dom.iterable",
        "es5",
        "es2015.collection",
        "es2015.iterable",
        "es2015.promise",
        "es2015.proxy",
        "es2018.promise",
        "es2016",
        "es2017.object",
        "es2018"
      ],
      "declaration": true,
      "sourceMap": true,
      "paths": {
         "@excalibur-tiled": ["./src/"]
      }
   },
   "include": ["example/**/*.ts", "./src/**/*.ts", "./test/unit/*.spec.ts", "files.d.ts"],
   "exclude": ["./example/**/*.tsx", "./example/vite.config.ts", "./test/e2e/*.ts"]
}
