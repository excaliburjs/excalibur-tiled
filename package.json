{
   "name": "@excaliburjs/plugin-tiled",
   "version": "1.0.0-alpha.0",
   "description": "excalibur-tiled provides Tiled map editor integration with Excalibur.js",
   "main": "build/esm/excalibur-tiled.min.js",
   "typings": "build/esm/src/index.d.ts",
   "exports": {
      "./package.json": "./package.json",
      ".": {
         "types": "./build/esm/src/index.d.ts",
         "import": "./build/esm/excalibur-tiled.min.js"
      }
   },
   "author": {
      "name": "Excalibur.js Team",
      "email": "excaliburjs@gmail.com",
      "url": "http://excaliburjs.com"
   },
   "homepage": "https://github.com/excaliburjs/excalibur-tiled",
   "repository": {
      "type": "git",
      "url": "git://github.com/excaliburjs/excalibur-tiled.git"
   },
   "bugs": {
      "url": "https://github.com/excaliburjs/excalibur-tiled/issues"
   },
   "license": "BSD-2-Clause",
   "keywords": [
      "excalibur",
      "game",
      "engine",
      "tiled",
      "maps",
      "map",
      "typescript",
      "javascript",
      "simple"
   ],
   "scripts": {
      "start": "vite example --port 4173 --open",
      "start:no-open": "vite example --port 4173",
      "watch": "vite",
      "types": "tsc --project tsconfig.json --declaration --emitDeclarationOnly",
      "type-check": "tsc --noEmit",
      "build:esm": "vite build && vite build --minify false",
      "build": "npm run build:esm && npm run types",
      "test": "npm run test:unit && npm run test:e2e",
      "test:unit": "vitest --project unit",
      "test:watch": "npm run test -- --watch",
      "test:e2e": "playwright test",
      "test:e2e:update": "playwright test --update-snapshots"
   },
   "devDependencies": {
      "@playwright/test": "1.63.0",
      "@types/jasmine": "5.1.15",
      "@types/jsdom": "21.1.7",
      "@types/json-diff": "1.0.3",
      "@types/node": "22.20.5",
      "@vitest/browser": "5.0.3",
      "@vitest/browser-playwright": "5.0.3",
      "cross-env": "10.1.0",
      "excalibur": "0.33.0-alpha.247",
      "http-server": "14.1.1",
      "json-diff": "1.0.6",
      "raw-loader": "4.0.2",
      "ts-loader": "9.6.2",
      "typescript": "7.0.2",
      "vite": "8.3.2",
      "vite-plugin-node-polyfills": "0.28.0",
      "vitest": "5.0.3"
   },
   "dependencies": {
      "compare-versions": "6.1.1",
      "pako": "3.0.2",
      "zod": "4.3.6",
      "zstddec": "0.3.1"
   },
   "peerDependencies": {
      "excalibur": ">=0.33.0-alpha.224"
   },
   "optionalDependencies": {
      "jsdom": "^27.0.0"
   },
   "browser": {
      "jsdom": false
   },
   "devEngines": {
      "runtime": {
         "name": "node",
         "onFail": "error",
         "version": ">=24"
      },
      "packageManager": {
         "name": "npm",
         "onFail": "error",
         "version": ">=11"
      }
   }
}
